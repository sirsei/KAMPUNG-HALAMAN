--// SERVICES
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local VIM = game:GetService("VirtualInputManager")

--// SETTINGS
local ANTI_AFK_ENABLED = false
local AUTO_SELL_ENABLED = false
local AUTO_SELL_DELAY_MINUTES = 1 
local selectedRarities = {} 

local rarities = {
    "Common","UnCommon","Rare","Epic","Legendary","Mythical","Unknown"
}

--// ANTI AFK LOGIC
Player.Idled:Connect(function()
    if ANTI_AFK_ENABLED then
        VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(1)
        VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end
end)

--// UI LOAD 
local DarkraiX = loadstring(game:HttpGet("https://raw.githubusercontent.com/GamingScripter/Kavo-Ui/main/Darkrai%20Ui", true))()
local Library = DarkraiX:Window("SeiX", "😜", "", Enum.KeyCode.RightControl)

--// RAINBOW FLOATING BUTTON (OPEN/CLOSE)
local openGui = Instance.new("ScreenGui", Player.PlayerGui)
openGui.ResetOnSpawn = false
local openBtn = Instance.new("TextButton", openGui)
openBtn.Size = UDim2.fromOffset(70, 32)
openBtn.Position = UDim2.new(0, 15, 0.5, -16)
openBtn.BackgroundColor3 = Color3.fromRGB(18,18,18)
openBtn.Text = "OPEN"
openBtn.Font = Enum.Font.GothamBold
openBtn.TextSize = 13
openBtn.TextColor3 = Color3.fromRGB(240,240,240)
openBtn.Draggable = true
openBtn.Active = true
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(0,6)
local stroke = Instance.new("UIStroke", openBtn)
stroke.Thickness = 2
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

task.spawn(function()
    local h = 0
    while task.wait(0.03) do
        h = (h + 0.005) % 1
        stroke.Color = Color3.fromHSV(h, 1, 1)
    end
end)

openBtn.MouseButton1Click:Connect(function()
    VIM:SendKeyEvent(true, Enum.KeyCode.RightControl, false, game)
    VIM:SendKeyEvent(false, Enum.KeyCode.RightControl, false, game)
end)

--// TABS
local Tab1 = Library:Tab("Main Settings")

Tab1:Toggle("Enable Anti-AFK", false, function(v)
    ANTI_AFK_ENABLED = v
end)

Tab1:Seperator("Auto Sell Settings")

Tab1:Toggle("Enable Auto Sell", false, function(v)
    AUTO_SELL_ENABLED = v
end)

Tab1:Slider("Sell Delay (Menit)", 1, 60, 1, function(v)
    AUTO_SELL_DELAY_MINUTES = v
end)

Tab1:Seperator("Pilih Rarity yang Dijual")

-- Membuat Toggle untuk setiap rarity (Multi-Select)
for _, r in ipairs(rarities) do
    Tab1:Toggle("Sell " .. r, false, function(v)
        selectedRarities[r] = v
    end)
end

--// AUTO SELL LOOP
task.spawn(function()
    while true do
        task.wait(1) -- Check setiap detik
        if AUTO_SELL_ENABLED then
            -- Loop berdasarkan rarity yang dipilih (true)
            for rarityName, isEnabled in pairs(selectedRarities) do
                if isEnabled then
                    pcall(function()
                        -- Mengirim perintah jual untuk rarity ini
                        ReplicatedStorage.SellFolder.RequestSell:FireServer(rarityName)
                    end)
                end
            end
            -- Tunggu berdasarkan menit yang diinput
            task.wait(AUTO_SELL_DELAY_MINUTES * 60)
        end
    end
end)

Library:Notification("Success", "Script Multi-Sell Loaded!", "Done")
